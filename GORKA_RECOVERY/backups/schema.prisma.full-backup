generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  timezone  String   @default("UTC")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  registrationNumber String? @map("registration_number")
  taxId              String? @map("tax_id")
  primaryContact     String? @map("primary_contact")
  contactEmail       String? @map("contact_email")
  contactPhone       String? @map("contact_phone")
  address            String?
  clientType         String? @map("client_type")

  users        User[]
  debtors      Debtor[]
  activityLogs ActivityLog[]
  connectors   Connector[]
  calendarEvents CalendarEvent[]

  @@map("organizations")
}

model User {
  id             String   @id @default(cuid())
  email          String   @unique
  passwordHash   String   @map("password_hash")
  password       String?
  name           String?
  role           String   @default("AGENT")
  organizationId String   @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id])
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  isActive       Boolean  @default(true) @map("is_active")
  lastLogin      DateTime? @map("last_login")

  actions        Action[]
  messageLogs    MessageLog[]
  activityLogs   ActivityLog[]

  @@map("users")
}

model Debtor {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id])
  name           String
  email          String?
  phone          String?
  address        String?
  totalDebt      Float?   @map("total_debt")
  daysOverdue    Int?     @map("days_overdue")
  status         String   @default("ACTIVE")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  nextFollowUpDate DateTime? @map("next_follow_up_date")
  nextPaymentDate  DateTime? @map("next_payment_date")

  debts          Debt[]
  actions        Action[]
  messageLogs    MessageLog[]
  calendarEvents CalendarEvent[]

  @@map("debtors")
}

model Debt {
  id          String   @id @default(cuid())
  debtorId    String   @map("debtor_id")
  debtor      Debtor   @relation(fields: [debtorId], references: [id])
  amount      Float
  currency    String   @default("USD")
  dueDate     DateTime @map("due_date")
  status      String   @default("PENDING")
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("debts")
}

model Action {
  id             String    @id @default(cuid())
  debtorId       String    @map("debtor_id")
  debtor         Debtor    @relation(fields: [debtorId], references: [id])
  assignedTo     String    @map("assigned_to")
  assignee       User      @relation(fields: [assignedTo], references: [id])
  type           String
  priority       String    @default("MEDIUM")
  status         String    @default("PENDING")
  description    String?
  dueDate        DateTime  @map("due_date")
  completedAt    DateTime? @map("completed_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  triggerEmail     Boolean  @default(false) @map("trigger_email")
  emailTemplateId  String?  @map("email_template_id")
  emailDelayHours  Int      @default(0) @map("email_delay_hours")
  messageLogId     String?  @map("message_log_id")

  triggerSms       Boolean  @default(false) @map("trigger_sms")
  smsTemplateId    String?  @map("sms_template_id")
  smsDelayHours    Int      @default(0) @map("sms_delay_hours")

  @@map("actions")
}

model ActivityLog {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id])
  userId         String?  @map("user_id")
  user           User?    @relation(fields: [userId], references: [id])
  action         String
  entityType     String   @map("entity_type")
  entityId       String?  @map("entity_id")
  details        Json?
  ipAddress      String?  @map("ip_address")
  userAgent      String?  @map("user_agent")
  createdAt      DateTime @default(now()) @map("created_at")

  @@map("activity_logs")
}

model CalendarEvent {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id])
  debtorId       String?  @map("debtor_id")
  debtor         Debtor?  @relation(fields: [debtorId], references: [id])
  title          String
  description    String?
  startDate      DateTime @map("start_date")
  endDate        DateTime @map("end_date")
  type           String   @default("TASK")
  status         String   @default("PENDING")
  source         String?
  sourceId       String?  @map("source_id")
  sourceDate     DateTime? @map("source_date")
  allDay         Boolean  @default(false) @map("all_day")
  eventType      String?  @map("event_type")
  createdBy      String?  @map("created_by")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@index([organizationId])
  @@index([startDate])
  @@unique([organizationId, eventType, debtorId, sourceDate])
  @@map("calendar_events")
}

model PermissionRole {
  id             String   @id @default(cuid())
  role           String   @unique
  organizationId String?  @map("organization_id")
  description    String?
  permissions    Json?
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@map("permission_roles")
}

model MessageLog {
  id               String    @id @default(cuid())
  jobId            String?   @unique @map("job_id")
  debtorId         String?   @map("debtor_id")
  debtor           Debtor?   @relation(fields: [debtorId], references: [id])
  userId           String?   @map("user_id")
  user             User?     @relation(fields: [userId], references: [id])
  templateId       String?   @map("template_id")
  template         Template? @relation(fields: [templateId], references: [id])

  contactEmail     String    @map("contact_email")
  contactName      String?   @map("contact_name")

  channel          String
  recipient        String
  subject          String?
  content          String
  contentPreview   String    @map("content_preview")

  status           String   @default("PENDING")

  provider         String?
  providerMessageId String?  @map("provider_message_id")
  providerData     Json?    @map("provider_data")

  sentAt           DateTime? @map("sent_at")
  deliveredAt      DateTime? @map("delivered_at")
  openedAt         DateTime? @map("opened_at")
  clickedAt        DateTime? @map("clicked_at")
  scheduledAt      DateTime? @map("scheduled_at")
  error            String?
  metadata         Json?
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  events           MessageEvent[]

  @@map("message_logs")
}

model MessageEvent {
  id           String    @id @default(cuid())
  messageLogId String    @map("message_log_id")
  messageLog   MessageLog @relation(fields: [messageLogId], references: [id])
  event        String
  data         Json?
  timestamp    DateTime  @default(now())
  createdAt    DateTime  @default(now()) @map("created_at")

  @@map("message_events")
}

model Template {
  id          String   @id @default(cuid())
  name        String   @unique
  channel     String
  subject     String?
  content     String
  category    String   @default("GENERAL")
  description String?
  isActive    Boolean  @default(true) @map("is_active")
  version     Int      @default(1)
  createdBy   String?  @map("created_by")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  messageLogs MessageLog[]

  @@map("templates")
}

model Connector {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id])
  name           String
  type           String
  provider       String
  status         String   @default("DISCONNECTED")
  config         String
  credentials    String
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  description    String?
  category       String?
  isDefault      Boolean  @default(false) @map("is_default")
  isEnabled      Boolean  @default(true) @map("is_enabled")
  acknowledged   Boolean  @default(false)
  lastTestedAt   DateTime? @map("last_tested_at")

  externalEnrichments ExternalEnrichment[]

  @@map("connectors")
}

model ExternalEnrichment {
  id              String    @id @default(cuid())
  connectorId     String    @map("connector_id")
  connector       Connector @relation(fields: [connectorId], references: [id])
  debtorId        String    @map("debtor_id")
  organizationId  String    @map("organization_id")
  externalScore   Int?      @map("external_score")
  riskLevel       String?   @map("risk_level")
  externalStatus  String?   @map("external_status")
  retrievedAt     DateTime  @default(now()) @map("retrieved_at")
  expiresAt       DateTime? @map("expires_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  @@map("external_enrichments")
}