{
 "compilerOptions": {
  "target": "ES2020",
  "useDefineForClassFields": true,
  "lib": ["ES2020", "DOM", "DOM.Iterable"],
  "module": "ESNext",
  "skipLibCheck": true,
  "moduleResolution": "bundler",
  "allowImportingTsExtensions": true,
  "resolveJsonModule": true,
  "isolatedModules": true,
  "noEmit": true,
  "jsx": "react-jsx",
  "strict": true,
  "noUnusedLocals": false,
  "noUnusedParameters": false,
  "noFallthroughCasesInSwitch": true,
  "esModuleInterop": true,
  "allowSyntheticDefaultImports": true,
  "ignoreDeprecations": "5.0",
  "types": ["vite/client"],
  "paths": {
    "@/*": ["./supervisor-dashboard/src/*"]
  }
},
  "include": [
    "supervisor-dashboard/src/**/*.ts",
    "supervisor-dashboard/src/**/*.tsx"
  ],
  "exclude": [
    "supervisor-dashboard/src/frontend/**/*",
    "supervisor-dashboard/src/renderer/**/*",
    "supervisor-dashboard/src/backend/**/*",
    "supervisor-dashboard/src/main/**/*",
    "node_modules",
    "dist",
    "src-tauri",
    "Backup*",
    "owner-dashboard",
    "super-admin-web",
    "gorka-supervisor-web"
  ]
}