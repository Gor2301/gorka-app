            &serde_json::to_string(&input.data).unwrap_or("{}".to_string()),
            &now,
            &now,
        ],
    ).map_err(|e| e.to_string())?;

    db::log_audit(conn, "INSERT", Some(&id), 1, "Inserted debtor")?;

    Ok(Debtor {
        id,
        organization_id,
        name: input.name,
        surname: input.surname,
        email: input.email,
        phone: input.phone,
        data: input.data,
        created_at: now.clone(),
